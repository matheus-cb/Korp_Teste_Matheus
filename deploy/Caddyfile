# SITE_ADDRESS controla o modo:
#   143-95-221-82.nip.io  -> HTTPS automatico (Let's Encrypt), sem comprar dominio
#   :80                   -> HTTP puro (use so para teste; o login vai em claro)
{$SITE_ADDRESS} {
	encode gzip zstd

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	# O nginx do frontend ja faz a separacao de rotas publicas e internas:
	# /inventory-api/ so libera catalogo e movimentos, o resto devolve 404.
	reverse_proxy frontend:80
}

# Outras aplicacoes na mesma maquina trazem o vhost delas.
#
# Existe porque a Caddy e deste compose e este arquivo e sobrescrito pelo deploy
# do NotaFlow. Vhost de outra aplicacao escrito aqui seria apagado pelo proximo
# deploy daqui, e vhost escrito la fora seria apagado por este arquivo: os dois
# deploys disputariam o mesmo destino. Com o import, cada aplicacao e dona de um
# arquivo proprio no diretorio, e este Caddyfile nao precisa saber quais existem.
#
# O diretorio e montado pelo compose. Se estiver vazio, a Caddy avisa e segue --
# o NotaFlow continua servindo sozinho.
import /etc/caddy/sites/*.caddy
