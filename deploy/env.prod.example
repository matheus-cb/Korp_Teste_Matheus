# Modelo do .env de PRODUCAO. O arquivo real vive apenas em /opt/notaflow/.env
# na VPS, com permissao 600, e NUNCA e versionado.
# Os segredos sao gerados no proprio servidor por deploy/bootstrap-vps.sh.

SITE_ADDRESS=143-95-221-82.nip.io
PUBLIC_ORIGIN=https://143-95-221-82.nip.io
PUBLIC_HOST=143-95-221-82.nip.io

IMAGE_INVENTORY=ghcr.io/matheus-cb/notaflow-inventory:latest
IMAGE_BILLING=ghcr.io/matheus-cb/notaflow-billing:latest
IMAGE_FRONTEND=ghcr.io/matheus-cb/notaflow-frontend:latest

POSTGRES_INVENTORY_PASSWORD=
POSTGRES_BILLING_PASSWORD=
INTERNAL_SERVICE_TOKEN=
SEED_PASSWORD=

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

# Copiloto. Vazio (ou "openai") usa o provedor original e exige OPENAI_API_KEY.
# "claude-bridge" usa o Claude Code da VPS atras da ponte local; o segredo sai
# de /etc/notaflow-bridge.env, criado por deploy/agent/install-bridge.sh.
AI_PROVIDER=
CLAUDE_BRIDGE_URL=http://host.docker.internal:5099/
CLAUDE_BRIDGE_SECRET=
CLAUDE_BRIDGE_MODEL=haiku
