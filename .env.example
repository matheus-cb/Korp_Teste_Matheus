# Copie este arquivo para .env. Nunca versione o .env real.
POSTGRES_INVENTORY_PASSWORD=inventory_dev_password
POSTGRES_BILLING_PASSWORD=billing_dev_password

# Opcional: sem a chave, apenas o Copiloto fica desabilitado.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

# Token interno entre Billing e Inventory/MCP. scripts/setup.ps1 gera um valor aleatório.
INTERNAL_SERVICE_TOKEN=

# Copiloto. Vazio deixa o assistente em AI_DISABLED e o fluxo manual intacto.
# "claude-bridge" exige a ponte rodando: veja deploy/README.md.
AI_PROVIDER=
CLAUDE_BRIDGE_URL=http://host.docker.internal:5099/
CLAUDE_BRIDGE_SECRET=
CLAUDE_BRIDGE_MODEL=sonnet
